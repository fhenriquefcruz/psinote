rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function userProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userProfileExists()
        && (!profile.keys().hasAny(['blocked']) || profile.blocked != true);
    }

    function ownsExistingRecord() {
      return isActiveUser()
        && resource.data.psychologistId == request.auth.uid;
    }

    function ownsIncomingRecord() {
      return isActiveUser()
        && request.resource.data.psychologistId == request.auth.uid;
    }

    function preservesOwnership() {
      return request.resource.data.psychologistId == resource.data.psychologistId;
    }

    function preservesCreationMetadata() {
      return request.resource.data.get('createdAt', null)
          == resource.data.get('createdAt', null)
        && request.resource.data.get('createdBy', null)
          == resource.data.get('createdBy', null);
    }

    function preservesPatientLink() {
      return request.resource.data.get('patientId', null)
        == resource.data.get('patientId', null);
    }

    function preservesLegacySessionHistory() {
      return request.resource.data.get('previousVersions', [])
        == resource.data.get('previousVersions', []);
    }

    function validSessionCreate() {
      return ownsIncomingRecord()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.get('version', 1) == 1
        && request.resource.data.get('revision', 1) == 1
        && request.resource.data.status in ['draft', 'scheduled'];
    }

    function validSessionRevisionStep() {
      let oldVersion = resource.data.get('version', 1);
      let newVersion = request.resource.data.get('version', 1);
      let oldRevision = resource.data.get('revision', oldVersion);
      let newRevision = request.resource.data.get('revision', oldRevision);
      return (newVersion == oldVersion || newVersion == oldVersion + 1)
        && newRevision == oldRevision + 1;
    }

    function validSessionStateTransition() {
      let oldStatus = resource.data.get('status', 'draft');
      let newStatus = request.resource.data.get('status', oldStatus);
      let oldVersion = resource.data.get('version', 1);
      let newVersion = request.resource.data.get('version', oldVersion);

      return (
          oldStatus in ['draft', 'scheduled']
          && newStatus == oldStatus
          && (newVersion == oldVersion || newVersion == oldVersion + 1)
        )
        || (
          oldStatus in ['draft', 'scheduled']
          && newStatus in ['finalized', 'archived']
          && newVersion == oldVersion + 1
        )
        || (
          oldStatus == 'finalized'
          && newStatus in ['draft', 'archived']
          && newVersion == oldVersion + 1
        )
        || (
          oldStatus == 'archived'
          && newStatus == 'draft'
          && newVersion == oldVersion + 1
        );
    }

    function validSessionUpdate() {
      return ownsExistingRecord()
        && preservesOwnership()
        && preservesPatientLink()
        && preservesCreationMetadata()
        && preservesLegacySessionHistory()
        && request.resource.data.updatedBy == request.auth.uid
        && validSessionRevisionStep()
        && validSessionStateTransition();
    }

    function validSessionVersionCreate() {
      let sessionId = request.resource.data.sessionId;
      let parentPath = /databases/$(database)/documents/sessions/$(sessionId);
      let parent = get(parentPath).data;
      let snapshot = request.resource.data.snapshot;

      return ownsIncomingRecord()
        && request.resource.data.keys().hasOnly([
          'psychologistId',
          'patientId',
          'sessionId',
          'version',
          'revision',
          'reason',
          'snapshot',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.version is int
        && request.resource.data.version > 0
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.snapshot is map
        && request.resource.data.reason in [
          'manual-save',
          'finalize',
          'reopen',
          'archive',
          'restore'
        ]
        && exists(parentPath)
        && parent.psychologistId == request.auth.uid
        && parent.patientId == request.resource.data.patientId
        && request.resource.data.version == parent.get('version', 1)
        && request.resource.data.revision
          == parent.get('revision', parent.get('version', 1))
        && snapshot.keys().hasOnly([
          'appointmentId',
          'sessionNumber',
          'patientName',
          'date',
          'mainTheme',
          'observations',
          'evolution',
          'interventions',
          'referrals',
          'agreements',
          'nextSteps',
          'tags',
          'status',
          'finalizedAt',
          'reopenedAt'
        ])
        && snapshot.get('appointmentId', null) == parent.get('appointmentId', null)
        && snapshot.get('sessionNumber', null) == parent.get('sessionNumber', null)
        && snapshot.get('patientName', null) == parent.get('patientName', null)
        && snapshot.get('date', null) == parent.get('date', null)
        && snapshot.get('mainTheme', '') == parent.get('mainTheme', '')
        && snapshot.get('observations', '') == parent.get('observations', '')
        && snapshot.get('evolution', '') == parent.get('evolution', '')
        && snapshot.get('interventions', '') == parent.get('interventions', '')
        && snapshot.get('referrals', '') == parent.get('referrals', '')
        && snapshot.get('agreements', '') == parent.get('agreements', '')
        && snapshot.get('nextSteps', '') == parent.get('nextSteps', '')
        && snapshot.get('tags', []) == parent.get('tags', [])
        && snapshot.get('status', 'draft') == parent.get('status', 'draft')
        && snapshot.get('finalizedAt', null) == parent.get('finalizedAt', null)
        && snapshot.get('reopenedAt', null) == parent.get('reopenedAt', null);
    }

    function validAppointmentCreate() {
      return ownsIncomingRecord()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status == 'scheduled'
        && request.resource.data.patientId is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.get('modality', 'in_person') in [
          'in_person',
          'online',
          'other'
        ];
    }

    function validAppointmentStateTransition() {
      let oldStatus = resource.data.get('status', 'scheduled');
      let newStatus = request.resource.data.get('status', oldStatus);

      return (
          oldStatus == 'scheduled'
          && newStatus in [
            'scheduled',
            'confirmed',
            'done',
            'canceled',
            'missed',
            'rescheduled'
          ]
        )
        || (
          oldStatus == 'confirmed'
          && newStatus in [
            'confirmed',
            'done',
            'canceled',
            'missed',
            'rescheduled'
          ]
        )
        || (
          oldStatus == 'done'
          && newStatus == 'done'
        )
        || (
          oldStatus == 'canceled'
          && newStatus == 'canceled'
        )
        || (
          oldStatus == 'missed'
          && newStatus == 'missed'
        )
        || (
          oldStatus == 'rescheduled'
          && newStatus == 'rescheduled'
        );
    }

    function validAppointmentRecordLink() {
      let oldSessionId = resource.data.get('sessionId', null);
      let newSessionId = request.resource.data.get('sessionId', oldSessionId);
      let oldCompletedAt = resource.data.get('recordCompletedAt', null);
      let newCompletedAt = request.resource.data.get(
        'recordCompletedAt',
        oldCompletedAt
      );

      return (
          newSessionId == oldSessionId
          && newCompletedAt == oldCompletedAt
        )
        || (
          resource.data.get('status', 'scheduled') == 'done'
          && request.resource.data.get('status', 'scheduled') == 'done'
          && oldSessionId == null
          && newSessionId is string
          && newCompletedAt != null
          && exists(
            /databases/$(database)/documents/sessions/$(newSessionId)
          )
          && get(
            /databases/$(database)/documents/sessions/$(newSessionId)
          ).data.psychologistId == request.auth.uid
          && get(
            /databases/$(database)/documents/sessions/$(newSessionId)
          ).data.patientId == resource.data.patientId
          && get(
            /databases/$(database)/documents/sessions/$(newSessionId)
          ).data.status == 'finalized'
        );
    }

    function validAppointmentChangedFields() {
      let status = resource.data.get('status', 'scheduled');
      let affected = request.resource.data.diff(resource.data).affectedKeys();

      return (
          status in ['scheduled', 'confirmed']
          && affected.hasOnly([
            'time',
            'duration',
            'modality',
            'notes',
            'status',
            'cancelReason',
            'rescheduledAt',
            'rescheduledToId',
            'updatedAt',
            'updatedBy'
          ])
        )
        || (
          status == 'done'
          && affected.hasOnly([
            'recordCompletedAt',
            'sessionId',
            'updatedAt',
            'updatedBy'
          ])
        )
        || (
          status in ['canceled', 'missed']
          && affected.hasOnly([
            'rescheduledAt',
            'rescheduledToId',
            'updatedAt',
            'updatedBy'
          ])
        )
        || (
          status == 'rescheduled'
          && affected.size() == 0
        );
    }

    function validAppointmentUpdate() {
      return ownsExistingRecord()
        && preservesOwnership()
        && preservesPatientLink()
        && preservesCreationMetadata()
        && request.resource.data.date == resource.data.date
        && request.resource.data.get('recurrence', null)
          == resource.data.get('recurrence', null)
        && request.resource.data.get('rescheduledFromId', null)
          == resource.data.get('rescheduledFromId', null)
        && request.resource.data.updatedBy == request.auth.uid
        && validAppointmentStateTransition()
        && validAppointmentRecordLink()
        && validAppointmentChangedFields();
    }

    function patientLinkBelongsToOwner(patientId) {
      return patientId == null
        || (
          patientId is string
          && exists(/databases/$(database)/documents/patients/$(patientId))
          && get(
            /databases/$(database)/documents/patients/$(patientId)
          ).data.psychologistId == request.auth.uid
        );
    }

    function validDocumentDraftCreate() {
      return ownsIncomingRecord()
        && request.resource.data.keys().hasOnly([
          'psychologistId',
          'patientId',
          'patientName',
          'templateId',
          'templateVersion',
          'templateType',
          'templateFamily',
          'values',
          'status',
          'familyId',
          'issueVersion',
          'supersedesDocumentId',
          'issuedDocumentId',
          'issuedAt',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && patientLinkBelongsToOwner(
          request.resource.data.get('patientId', null)
        )
        && request.resource.data.templateId is string
        && request.resource.data.templateVersion is int
        && request.resource.data.templateVersion > 0
        && request.resource.data.values is map
        && request.resource.data.status == 'draft'
        && request.resource.data.familyId is string
        && request.resource.data.issueVersion is int
        && request.resource.data.issueVersion > 0
        && request.resource.data.get('issuedDocumentId', null) == null
        && request.resource.data.get('issuedAt', null) == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validDocumentDraftUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let newStatus = request.resource.data.get('status', 'draft');
      let issuedDocumentId = request.resource.data.get(
        'issuedDocumentId',
        null
      );
      let issuedDocumentPath = /databases/$(database)/documents/documents/$(issuedDocumentId);

      return ownsExistingRecord()
        && resource.data.status == 'draft'
        && preservesOwnership()
        && preservesPatientLink()
        && preservesCreationMetadata()
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.templateVersion == resource.data.templateVersion
        && request.resource.data.templateType == resource.data.templateType
        && request.resource.data.templateFamily == resource.data.templateFamily
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.issueVersion == resource.data.issueVersion
        && request.resource.data.get('supersedesDocumentId', null)
          == resource.data.get('supersedesDocumentId', null)
        && request.resource.data.updatedBy == request.auth.uid
        && affected.hasOnly([
          'values',
          'status',
          'issuedDocumentId',
          'issuedAt',
          'updatedAt',
          'updatedBy'
        ])
        && (
          (
            newStatus == 'draft'
            && request.resource.data.get('issuedDocumentId', null) == null
            && request.resource.data.get('issuedAt', null) == null
          )
          || (
            newStatus == 'issued'
            && issuedDocumentId is string
            && request.resource.data.get('issuedAt', null) != null
            && existsAfter(issuedDocumentPath)
            && getAfter(issuedDocumentPath).data.psychologistId
              == request.auth.uid
            && getAfter(issuedDocumentPath).data.draftId
              == resource.id
            && getAfter(issuedDocumentPath).data.status == 'issued'
          )
        );
    }

    function validDocumentCreate() {
      let kind = request.resource.data.get('kind', 'attachment');
      let status = request.resource.data.get('status', 'stored');
      let draftId = request.resource.data.get('draftId', null);
      let draftPath = /databases/$(database)/documents/document_drafts/$(draftId);

      return ownsIncomingRecord()
        && patientLinkBelongsToOwner(
          request.resource.data.get('patientId', null)
        )
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.storageProvider == 'firebase'
        && request.resource.data.storagePath is string
        && request.resource.data.fileType is string
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize > 0
        && request.resource.data.version is int
        && request.resource.data.version > 0
        && (
          (
            kind == 'attachment'
            && status == 'stored'
            && draftId == null
            && request.resource.data.get('templateId', null) == null
            && request.resource.data.get('templateVersion', null) == null
            && request.resource.data.get('familyId', null) == null
            && request.resource.data.get('issuedAt', null) == null
          )
          || (
            kind == 'generated'
            && status == 'issued'
            && draftId is string
            && request.resource.data.templateId is string
            && request.resource.data.templateVersion is int
            && request.resource.data.familyId is string
            && request.resource.data.issuedBy == request.auth.uid
            && request.resource.data.get('issuedAt', null) != null
            && existsAfter(draftPath)
            && getAfter(draftPath).data.psychologistId == request.auth.uid
            && getAfter(draftPath).data.patientId
              == request.resource.data.get('patientId', null)
            && getAfter(draftPath).data.templateId
              == request.resource.data.templateId
            && getAfter(draftPath).data.templateVersion
              == request.resource.data.templateVersion
            && getAfter(draftPath).data.familyId
              == request.resource.data.familyId
            && getAfter(draftPath).data.issueVersion
              == request.resource.data.version
            && getAfter(draftPath).data.status == 'issued'
            && getAfter(draftPath).data.issuedDocumentId
              == resource.id
          )
        );
    }

    function safeActivityPayload() {
      return request.resource.data.keys().hasOnly([
          'psychologistId',
          'user',
          'action',
          'target',
          'targetId',
          'details',
          'timestamp'
        ])
        && request.resource.data.user == request.auth.uid
        && request.resource.data.details.keys().hasOnly([
          'version',
          'status',
          'patientId',
          'patientLinked',
          'fileType',
          'fileSize',
          'storageProvider',
          'originalId'
        ]);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.blocked == false;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'phone',
          'photoURL',
          'crp',
          'crpUf',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /patients/{recordId} {
      allow create: if ownsIncomingRecord();
      allow read: if ownsExistingRecord();
      allow update: if ownsExistingRecord()
        && preservesOwnership()
        && preservesCreationMetadata();
      allow delete: if false;
    }

    match /sessions/{recordId} {
      allow create: if validSessionCreate();
      allow read: if ownsExistingRecord();
      allow update: if validSessionUpdate();
      allow delete: if false;
    }

    match /session_versions/{versionId} {
      allow create: if validSessionVersionCreate();
      allow read: if ownsExistingRecord();
      allow update, delete: if false;
    }

    match /appointments/{recordId} {
      allow create: if validAppointmentCreate();
      allow read: if ownsExistingRecord();
      allow update: if validAppointmentUpdate();
      allow delete: if false;
    }

    match /document_drafts/{recordId} {
      allow create: if validDocumentDraftCreate();
      allow read: if ownsExistingRecord();
      allow update: if validDocumentDraftUpdate();
      allow delete: if false;
    }

    match /documents/{recordId} {
      allow create: if validDocumentCreate();
      allow read: if ownsExistingRecord();
      allow update, delete: if false;
    }

    match /activities/{recordId} {
      allow create: if ownsIncomingRecord() && safeActivityPayload();
      allow read: if ownsExistingRecord();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
