{
  "name": "psinote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "security:check": "node scripts/security-check.mjs",
    "validate": "npm run security:dependencies && npm run security:check && npm run test:unit && npm run test:rules && npm run build",
    "security:dependencies": "npm audit --audit-level=moderate",
    "test:rules": "npx --yes firebase-tools@15.30.2 emulators:exec --project demo-psinote-rules --only firestore,storage \"node --test tests/security-rules/*.test.mjs\"",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "firebase": "12.19.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "7.18.4",
    "react-toastify": "^9.1.3",
    "recharts": "^2.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.2",
    "@firebase/rules-unit-testing": "5.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
