rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function allowedDocumentType() {
      return request.resource.contentType.matches(
        'application/pdf|image/jpeg|image/png|image/webp|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      );
    }

    match /users/{uid}/documents/{allPaths=**} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && allowedDocumentType();

      // Browser clients never destructively replace or remove stored clinical
      // files. Retention/disposal requires a trusted privileged workflow.
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
