rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function allowedDocumentType() {
      return request.resource.contentType.matches(
        'application/pdf|image/jpeg|image/png|image/webp|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      );
    }

    match /users/{uid}/documents/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.size <= 10 * 1024 * 1024
        && allowedDocumentType();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
