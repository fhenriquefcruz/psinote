rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isActiveOwner(uid) {
      let profilePath = /databases/(default)/documents/users/$(uid);
      return request.auth != null
        && request.auth.uid == uid
        && firestore.exists(profilePath)
        && firestore.get(profilePath).data.get('blocked', false) != true;
    }

    function allowedDocumentType() {
      return request.resource.contentType.matches(
        'application/pdf|image/jpeg|image/png|image/webp|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      );
    }

    // Cloud Storage -> Firestore authorization requires the Firebase-managed
    // cross-service IAM permission when deploying to a real project.
    // Consult docs/PHASE_9_PRIVACY_SECURITY.md before production rollout.
    match /users/{uid}/documents/{allPaths=**} {
      allow read: if isActiveOwner(uid);

      allow create: if isActiveOwner(uid)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && allowedDocumentType();

      // Browser clients never destructively replace or remove stored clinical
      // files. Retention/disposal requires a trusted privileged workflow.
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
