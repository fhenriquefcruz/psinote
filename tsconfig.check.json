{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "tests/**/*.js",
    "tests/**/*.mjs",
    "scripts/**/*.mjs",
    "playwright.config.js",
    "playwright.production.config.js",
    "vite.config.js"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
